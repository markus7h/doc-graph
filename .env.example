# Container läuft auf myubuntu, nutzt den llm-stack (Repo llm-stack):
# qwen3-14B + bge-m3 laufen dauerhaft auf myai (LAN, wird vor dem Ingest per
# WoL geweckt) — doc-graph ist komplett qwen-only (A/B-Test 2026-08-03:
# qwen auf Augenhöhe bis besser als mistral bei deutschen Antworten).
# OpenAI-kompatibles /v1. Kontext ist server-seitig via -c gesetzt.
LLM_BASE_URL=http://myai:11436/v1
LLM_MODEL=qwen3:14b

# bge-m3: mehrsprachig (Deutsch!), 1024 Dim — identisch zu paperless-ai. Läuft
# dauerhaft auf myais RTX 2060 (llm-stack, docker-compose.myai.yml).
EMBED_BASE_URL=http://myai:11435/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# Parallele LLM-Calls beim Indexieren. 2 ist für eine RTX 5080 konservativ.
MAX_ASYNC=2

# Paperless-NGX (Dokumentquelle): volle URL zur laufenden Instanz + API-Token.
# LAN-interne NGX via DNS 'paperless' (self-signed Cert -> Client mit verify=False).
# Kann leer bleiben: compose-Default ist https://paperless/.
PAPERLESS_URL=https://paperless/
PAPERLESS_TOKEN=dein_paperless_api_token

# Host, unter dem der Graph-Viewer vom Browser erreichbar ist.
PUBLIC_HOST=myubuntu

# Kontext-Budget je Query (Default 12000). Auf 6000 gedeckelt: LightRAG
# überschreitet sein Budget um bis zu ~2,5x (beobachtet 2026-08-03), und der
# Query-Prompt muss in qwens 24576er-Kontext auf myai passen.
QUERY_MAX_TOKENS=6000
